{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Title": "EduScroll API",
    "Version": "v1",
    "Description": "Backend API foundation for EduScroll educational short-video discovery.",
    "EnableOpenApi": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR_ALLOWED_FRONTEND_ORIGIN"
    ],
    "AllowCredentials": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=EduScrollDb;User Id=YOUR_DB_USER;Password=REPLACE_WITH_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "EduScroll.API",
    "Audience": "EduScroll.Clients",
    "SecretKey": "REPLACE_WITH_AT_LEAST_32_BYTE_SECRET_KEY",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "SourceIngestion": {
    "MinExtractedTextLength": 50,
    "MaxExtractedTextLength": 200000,
    "PreviewMaxLength": 240,
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "WebFetch": {
      "ConnectTimeoutSeconds": 10,
      "RequestTimeoutSeconds": 20,
      "MaxResponseBytes": 2097152,
      "MaxRedirects": 3,
      "UserAgent": "EduScrollBot/1.0 (+https://eduscroll.app)",
      "AllowedContentTypes": [
        "text/html",
        "application/xhtml+xml"
      ]
    }
  },
  "AiProvider": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "ApiKey": "REPLACE_WITH_OPTIONAL_AI_PROVIDER_API_KEY_OR_LEAVE_EMPTY_FOR_LOCAL_OLLAMA",
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "RetryBaseDelayMilliseconds": 500,
    "MinInputCharacters": 50,
    "MaxInputCharacters": 24000,
    "MaxSchemaRepairAttempts": 1,
    "MaxSummaryLength": 1200,
    "MaxTopics": 5,
    "MaxSubtopicsPerTopic": 4,
    "MaxConcepts": 10,
    "MaxKeywords": 12,
    "SingleLanguageMinSearchQueries": 3,
    "SingleLanguageMaxSearchQueries": 8,
    "DualLanguageMinSearchQueriesPerLanguage": 2,
    "DualLanguageMaxSearchQueriesPerLanguage": 5,
    "Temperature": 0.1,
    "PromptVersion": "v1.1"
  },
  "AllowedHosts": "YOUR_ALLOWED_HOST_OR_SEMICOLON_LIST"
}
