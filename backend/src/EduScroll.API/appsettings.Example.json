{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Title": "EduScroll API",
    "Version": "v1",
    "Description": "Backend API foundation for EduScroll educational short-video discovery.",
    "EnableOpenApi": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://YOUR_ALLOWED_FRONTEND_ORIGIN"
    ],
    "AllowCredentials": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=EduScrollDb;User Id=YOUR_DB_USER;Password=REPLACE_WITH_DB_PASSWORD;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Jwt": {
    "Issuer": "EduScroll.API",
    "Audience": "EduScroll.Clients",
    "SecretKey": "REPLACE_WITH_AT_LEAST_32_BYTE_SECRET_KEY",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "AllowedHosts": "YOUR_ALLOWED_HOST_OR_SEMICOLON_LIST"
}
