{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "EnableOpenApi": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://test.eduscroll.local"
    ],
    "AllowCredentials": false
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "EduScroll.API.Tests",
    "Audience": "EduScroll.TestClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 5
  },
  "SourceIngestion": {
    "MinExtractedTextLength": 50,
    "MaxExtractedTextLength": 200000,
    "PreviewMaxLength": 240,
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "WebFetch": {
      "ConnectTimeoutSeconds": 5,
      "RequestTimeoutSeconds": 10,
      "MaxResponseBytes": 2097152,
      "MaxRedirects": 3,
      "UserAgent": "EduScrollTestBot/1.0",
      "AllowedContentTypes": [
        "text/html",
        "application/xhtml+xml"
      ]
    }
  },
  "AiProvider": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "ApiKey": "",
    "TimeoutSeconds": 10,
    "MaxRetries": 1,
    "RetryBaseDelayMilliseconds": 10,
    "MinInputCharacters": 50,
    "MaxInputCharacters": 24000,
    "MaxSchemaRepairAttempts": 1,
    "MaxSummaryLength": 1200,
    "MaxTopics": 5,
    "MaxSubtopicsPerTopic": 4,
    "MaxConcepts": 10,
    "MaxKeywords": 12,
    "SingleLanguageMinSearchQueries": 3,
    "SingleLanguageMaxSearchQueries": 8,
    "DualLanguageMinSearchQueriesPerLanguage": 2,
    "DualLanguageMaxSearchQueriesPerLanguage": 5,
    "Temperature": 0.1,
    "PromptVersion": "v1.1"
  },
  "YouTube": {
    "ApiBaseUrl": "https://www.googleapis.com/youtube/v3",
    "RssBaseUrl": "https://www.youtube.com/feeds/videos.xml",
    "ApiKey": "",
    "TimeoutSeconds": 5,
    "MaxRetries": 1,
    "RetryBaseDelayMilliseconds": 10,
    "MetadataBatchSize": 50,
    "MaxVideosPerChannelPerSync": 15
  }
}
