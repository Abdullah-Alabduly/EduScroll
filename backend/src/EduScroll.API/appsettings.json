{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Title": "EduScroll API",
    "Version": "v1",
    "Description": "Backend API foundation for EduScroll educational short-video discovery.",
    "EnableOpenApi": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "EduScroll.API",
    "Audience": "EduScroll.Clients",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "SourceIngestion": {
    "MinExtractedTextLength": 50,
    "MaxExtractedTextLength": 200000,
    "PreviewMaxLength": 240,
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "WebFetch": {
      "ConnectTimeoutSeconds": 10,
      "RequestTimeoutSeconds": 20,
      "MaxResponseBytes": 2097152,
      "MaxRedirects": 3,
      "UserAgent": "EduScrollBot/1.0 (+https://eduscroll.app)",
      "AllowedContentTypes": [
        "text/html",
        "application/xhtml+xml"
      ]
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}