{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Title": "EduScroll API",
    "Version": "v1",
    "Description": "Backend API foundation for EduScroll educational short-video discovery.",
    "EnableOpenApi": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "EduScroll.API",
    "Audience": "EduScroll.Clients",
    "SecretKey": "",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "SourceIngestion": {
    "MinExtractedTextLength": 50,
    "MaxExtractedTextLength": 200000,
    "PreviewMaxLength": 240,
    "DefaultPageSize": 20,
    "MaxPageSize": 50,
    "WebFetch": {
      "ConnectTimeoutSeconds": 10,
      "RequestTimeoutSeconds": 20,
      "MaxResponseBytes": 2097152,
      "MaxRedirects": 3,
      "UserAgent": "EduScrollBot/1.0 (+https://eduscroll.app)",
      "AllowedContentTypes": [
        "text/html",
        "application/xhtml+xml"
      ]
    }
  },
  "AiProvider": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3.2",
    "ApiKey": "",
    "TimeoutSeconds": 60,
    "MaxRetries": 2,
    "RetryBaseDelayMilliseconds": 500,
    "MinInputCharacters": 50,
    "MaxInputCharacters": 24000,
    "MaxSchemaRepairAttempts": 1,
    "MaxSummaryLength": 1200,
    "MaxTopics": 5,
    "MaxSubtopicsPerTopic": 4,
    "MaxConcepts": 10,
    "MaxKeywords": 12,
    "SingleLanguageMinSearchQueries": 3,
    "SingleLanguageMaxSearchQueries": 8,
    "DualLanguageMinSearchQueriesPerLanguage": 2,
    "DualLanguageMaxSearchQueriesPerLanguage": 5,
    "Temperature": 0.1,
    "PromptVersion": "v1.1",
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "Model": "gemini-4-hydrogen",
      "ApiKey": "",
      "TimeoutSeconds": 60,
      "MaxRetries": 2,
      "RetryBaseDelayMilliseconds": 500
    }
  },
  "YouTube": {
    "ApiBaseUrl": "https://www.googleapis.com/youtube/v3",
    "RssBaseUrl": "https://www.youtube.com/feeds/videos.xml",
    "ApiKey": "",
    "TimeoutSeconds": 15,
    "MaxRetries": 2,
    "RetryBaseDelayMilliseconds": 500,
    "MetadataBatchSize": 50,
    "MaxVideosPerChannelPerSync": 15,
    "EnableSearchFallback": true,
    "MinLocalCandidatesThreshold": 15,
    "MaxFallbackQueriesPerDiscovery": 2,
    "MaxFallbackResultsPerQuery": 10,
    "SearchVideoDuration": "short",
    "MaxVideoDurationSeconds": 240
  },
  "AllowedHosts": "localhost;127.0.0.1"
}